# Baseline for introducing PHPStan at level 6 on an existing codebase.
#
# Three accepted categories, none of which are real bugs:
# - missingType.iterableValue: every `array`-typed param/property/return would need a
#   generic shape annotation (e.g. array<string, mixed>) to satisfy level 6's strictness.
#   Real, mechanical work with low bug-finding value here; left for a future pass rather
#   than rushed through now.
# - class.notFound (WP_CLI) / function.notFound (pll_the_languages, pll_get_post): WP-CLI
#   and Polylang are optional runtime dependencies the WordPress stubs don't cover; both are
#   already guarded with `class_exists()`/`function_exists()` checks at their call sites.
# - return.void: MetaBox::do_save()/TermMeta::do_save() are hooked as actions (whose return
#   value WordPress ignores) but deliberately return a value for direct, non-hook callers —
#   see their own abstract save() contracts. Not a bug.
#
# One exception, NOT a false positive, intentionally left rather than fixed now:
# - booleanAnd.alwaysFalse / identical.alwaysFalse in Annotations.php's hand-rolled parser
#   state machine (~line 150): PHPStan is correct that `$composing === true` can't be true
#   at that point given the surrounding `elseif ( ! $composing && ... )` guard, so that
#   specific malformed-input check is dead code. Fixing it means touching the parser's
#   control flow, which needs its own test coverage first rather than a drive-by change
#   alongside unrelated tooling work.
parameters:
	ignoreErrors:
		-
			message: '#^Method Netivo\\Core\\Admin\\BulkAction\:\:add_action\(\) has parameter \$actions with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Core/Admin/BulkAction.php

		-
			message: '#^Method Netivo\\Core\\Admin\\BulkAction\:\:add_action\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Core/Admin/BulkAction.php

		-
			message: '#^Method Netivo\\Core\\Admin\\BulkAction\:\:do_action\(\) has parameter \$ids with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Core/Admin/BulkAction.php

		-
			message: '#^Method Netivo\\Core\\Admin\\BulkAction\:\:handle\(\) has parameter \$ids with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Core/Admin/BulkAction.php

