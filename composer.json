{
  "name": "netivo/wp-core",
  "description": "WP Core Library for Netivo themes",
  "minimum-stability": "stable",
  "license": "proprietary",
  "version": "1.3.1",
  "authors": [
    {
      "name": "netivo",
      "email": "biuro@netivo.pl"
    },
    {
      "name": "Michał Świątek",
      "email": "michal.swiatek@netivo.pl"
    }
  ],
  "require": {
    "php": ">=8.4"
  },
  "extra": {
    "wordpress-minimum-version": "6.3"
  },
  "autoload": {
    "psr-4": {
      "Netivo\\Core\\": "src/Core"
    }
  },
  "require-dev": {
    "automattic/vipwpcs": "^3.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
    "phpcompatibility/php-compatibility": "10.0.0-alpha2"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "scripts": {
    "lint": "phpcs --standard=phpcs.xml.dist -d memory_limit=1024M --runtime-set timeout 300",
    "lint:fix": "phpcbf --standard=phpcs.xml.dist -d memory_limit=1024M --runtime-set timeout 300"
  }
}
